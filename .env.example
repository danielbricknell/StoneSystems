DATABASE_URL="postgresql://fieldservice:fieldservice@localhost:5432/fieldservice?schema=public"
GOOGLE_PLACES_API_KEY=""
SESSION_SECRET=""

# --- Production-only (leave unset for local dev) ---
# Auto-set by Vercel when you provision Blob storage from the dashboard;
# job attachments upload there instead of local disk when this is set.
BLOB_READ_WRITE_TOKEN=""
# Required by prisma/seed.ts when NODE_ENV=production — the seed refuses to
# create the default admin without a real password set here.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
